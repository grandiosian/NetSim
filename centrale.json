    "sites_a_autoriser": [
      "https://grandiosian.github.io"
    ],
    "chargement": "Le module est chargé à la fin de la page. S’il est injoignable, NetSim fonctionne seul (enregistrement dans le navigateur).",
    "connexion": {
      "bouton": "« Mon code » dans la barre du haut ; une fois connecté, il affiche « classe · élève » et permet de se déconnecter.",
      "depuis_le_portail": "Jeton dans l’adresse (#centrale=…) : connexion automatique, le module retire le jeton.",
      "activite_directe": "Centrale.activiteDemandee() renvoie une clé d’exercice (ex. e5-1) : NetSim l’ouvre, sauf si l’élève est déjà dessus.",
      "retour": "Bouton « ← Mes ateliers » ajouté par le module."
    },
    "fonctions_utilisees": [
      "init",
      "afficherConnexion",
      "connecte",
      "session",
      "deconnexion",
      "charger",
      "sauver",
      "progression",
      "mesProgressions",
      "activiteDemandee"
