    ]
  },
  "$defs": {
    "Activite": {
      "type": "object",
      "required": [
        "id",
        "titre",
        "groupe",
        "total"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "titre": {
          "type": "string"
        },
        "groupe": {
          "type": "string"
        },
        "total": {
          "type": "integer"
        }
      }
    },
    "Progression": {
      "type": "object",
      "required": [
        "faites",
        "total",
        "statut"
      ],
      "properties": {
        "titre": {
          "type": "string"
        },
        "faites": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "statut": {
          "enum": [
            "commence",
            "termine"
          ]
        }
      }
    },
    "Decouvertes": {
      "type": "array",
      "items": {
        "enum": [
          "browser",
          "cable",
          "erase",
          "export",
          "frames",
          "gwfield",
          "ipfield",
          "maskfield",
          "opendev",
          "pause",
          "play",
          "route",
          "routerport",
          "settings",
          "terminal"
        ]
      },
      "uniqueItems": true
    },
    "ProgressionLocale": {
      "type": "object",
      "description": "Clé = id d’exercice ; __seen = découvertes.",
      "properties": {
        "__seen": {
          "$ref": "#/$defs/Decouvertes"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "description": "total"
          },
          "best": {
            "type": "integer",
            "description": "faites"
          },
          "started": {
            "type": "boolean"
          },
          "done": {
            "type": "boolean",
            "description": "statut = termine"
          }
        }
      }
    },
    "Scenario": {
      "type": "object",
      "required": [
        "devices",
        "cables"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Appareil"
          }
        },
        "cables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Cable"
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Salle"
          }
        },
        "nextId": {
          "type": "integer",
          "description": "Prochain identifiant libre, partagé par appareils, câbles et salles."
        },
        "level": {
          "enum": [
            0,
            1,
            2
          ],
          "description": "Niveau : 0 = 5e, 1 = 4e, 2 = 3e."
        },
        "help": {
          "type": "boolean",
          "description": "Alertes de configuration affichées."
        },
        "exo": {
          "$ref": "#/$defs/ExerciceEnCours"
        }
      }
    },
    "Appareil": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "pc",
            "laptop",
            "phone",
            "rpi",
            "server",
            "printer",
            "esp32",
            "switch",
            "router"
          ]
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "ip": {
          "type": "string",
          "pattern": "^$|^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "description": "Adresse IPv4 en notation pointée, ou chaîne vide si non configurée."
        },
        "mask": {
          "type": "string",
          "pattern": "^$|^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "description": "Adresse IPv4 en notation pointée, ou chaîne vide si non configurée."
        },
        "gw": {
          "type": "string",
          "pattern": "^$|^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
          "description": "Adresse IPv4 en notation pointée, ou chaîne vide si non configurée."
        },
        "mac": {
          "type": "string",
          "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$"
        },
        "web": {
          "type": "object",
          "description": "PC, portable, Raspberry Pi, serveur, imprimante.",
          "properties": {
            "on": {
              "type": "boolean"
            },
            "page": {
              "type": "string",
              "description": "Texte de la page ; la 1re ligne est le titre."
            }
          }
        },
        "sensor": {
          "type": "object",
          "description": "ESP32 uniquement.",
          "properties": {
            "on": {
              "type": "boolean"
            }
          }
        },
        "ifs": {
          "type": "array",
          "description": "Routeur uniquement : un élément par port, eth0 à eth3.",
          "items": {
            "type": "object",
            "properties": {
              "ip": {
                "type": "string",
                "pattern": "^$|^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
                "description": "Adresse IPv4 en notation pointée, ou chaîne vide si non configurée."
              },
              "mask": {
                "type": "string",
                "pattern": "^$|^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
                "description": "Adresse IPv4 en notation pointée, ou chaîne vide si non configurée."
              },
              "mac": {
                "type": "string",
                "pattern": "^([0-9A-F]{2}:){5}[0-9A-F]{2}$"
              }
            }
          }
        },
        "routes": {
          "type": "array",
          "description": "Routeur uniquement : routes statiques.",
          "items": {
            "type": "object",
            "properties": {
              "net": {
                "type": "string",
                "pattern": "^$|^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
                "description": "Adresse IPv4 en notation pointée, ou chaîne vide si non configurée."
              },
              "mask": {
                "type": "string",
                "pattern": "^$|^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
                "description": "Adresse IPv4 en notation pointée, ou chaîne vide si non configurée."
              },
              "via": {
                "type": "string",
                "pattern": "^$|^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$",
                "description": "Adresse IPv4 en notation pointée, ou chaîne vide si non configurée."
              }
            }
          }
        }
      }
    },
    "Cable": {
      "type": "object",
      "required": [
        "id",
        "a",
        "b"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "a": {
          "$ref": "#/$defs/Extremite"
        },
        "b": {
          "$ref": "#/$defs/Extremite"
        }
      }
    },
    "Extremite": {
      "type": "object",
      "required": [
        "d",
        "p"
      ],
      "properties": {
        "d": {
          "type": "integer",
          "description": "id de l’appareil"
        },
        "p": {
          "type": "integer",
          "minimum": 0,
          "description": "Port : 0 pour un poste, 0 à 7 pour un switch, 0 à 3 pour un routeur."
        }
      }
    },
    "Salle": {
      "type": "object",
      "required": [
        "id",
        "name",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "color": {
          "enum": [
            "bleu",
            "vert",
            "orange",
            "violet",
            "rose",
            "gris"
          ]
        }
      }
    },
    "ExerciceEnCours": {
      "type": "object",
      "description": "Présent si le schéma est un exercice : la consigne voyage avec le schéma.",
      "properties": {
        "k": {
          "type": "string",
          "description": "id de l’exercice (= id d’activité)"
        },
        "c": {
          "enum": [
            "5e",
            "4e",
            "3e"
          ]
        },
        "cat": {
          "type": "string"
        },
        "t": {
          "type": "string",
          "description": "titre"
        },
        "dur": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "q": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "questions"
        },
        "verif": {
          "type": "string"
        },
        "cur": {
          "type": "integer",
          "description": "nombre d’étapes faites"
        },
        "done": {
          "type": "array",
          "items": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}