  "progression": {
    "envoi": "Centrale.progression(id, NetSim.progression(id))",
    "quand": [
      "ouverture d’un exercice (faites = 0)",
      "chaque étape validée, automatiquement ou par le bouton « étape suivante / passer »",
      "dernière étape validée (statut = termine)"
    ],
    "champs": {
      "titre": "titre de l’exercice",
      "faites": "meilleur nombre d’étapes validées",
      "total": "nombre d’étapes de l’exercice",
      "statut": "commence | termine"
    },
    "champs_non_utilises": [
      "score",
      "score_max",
      "details"
    ],
    "a_la_connexion": "NetSim lit mesProgressions(), garde le meilleur entre le navigateur et le serveur (NetSim.fusionnerProgression), puis renvoie les exercices où le navigateur est en avance.",
    "format": {
      "$ref": "#/$defs/Progression"
    }
  },
  "donnees": {
    "schema": {
      "description": "Le réseau en cours : appareils, câbles, salles, réglages, et la consigne si c’est un exercice. Même contenu que Fichier → Exporter.",
      "sauvegarde": "300 ms après chaque modification ; la Centrale regroupe les envois (3 s au plus).",
      "chargement": "À la connexion : si le serveur a un schéma différent, il remplace celui du navigateur (l’ancien reste accessible avec Annuler). Sinon le schéma du navigateur est envoyé.",
      "taille_typique": "5 à 40 Ko (limite de la Centrale : 2 Mo par clé).",
      "format": {
        "$ref": "#/$defs/Scenario"
      }
    },
    "decouvertes": {
      "description": "Types d’actions déjà réalisées par l’élève. Sert à réduire l’aide « Comment faire » au fil des exercices.",
      "sauvegarde": "À chaque progression.",
      "chargement": "À la connexion, réuni avec celles du navigateur.",
      "format": {
        "$ref": "#/$defs/Decouvertes"
      }
    }
  },
  "fichiers": {
    "utilises": false,
    "note": "NetSim n’envoie pas de fichiers et n’utilise pas encore le dossier de projet des ateliers transversaux."
